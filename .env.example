# eBay API Credentials (Production)
EBAY_APP_ID=your_production_app_id
EBAY_CERT_ID=your_production_cert_id
EBAY_DEV_ID=your_dev_id

# eBay API Credentials (Sandbox - optional)
EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_CERT_ID=

# Environment: production or sandbox
EBAY_ENVIRONMENT=production

# Marketplace: EBAY_GB, EBAY_US, etc.
EBAY_MARKETPLACE=EBAY_GB

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Web Server Configuration
WEB_PORT=8088
WEB_HOST=0.0.0.0

# Database Path (in container)
DB_PATH=/data/sniper.db

# Snipe Configuration
BID_OFFSET_SECONDS=8
BID_RETRY_OFFSET_SECONDS=3
RESULT_CHECK_DELAY_SECONDS=30

# NTP Server
NTP_SERVER=pool.ntp.org

# Bid Placement Stub (true until scope granted)
BID_PLACEMENT_STUBBED=true